{
  "lastChangelogVersion": "1.5.2",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "theme": "light",
  "packages": [
    "npm:pi-token-usage",
    "npm:pi-move-session",
    "npm:pi-token-speed",
    "git:github.com/burneikis/pi-vim",
    "npm:@llblab/pi-codex-usage",
    "npm:pi-subagents"
  ],
  "showHardwareCursor": true,
  "quietStartup": true,
  "editorPaddingX": 1,
  "enabledModels": [
    "openai-codex/gpt-5.5",
    "llama-cpp-qwen/Qwen3.6-35B-A3B-UD-IQ4_NL_XL",
    "llama-cpp-qwen/Qwen3.6-35B-A3B-UD-IQ3_S",
    "llama-cpp-qwen/Qwen3-8B-Q4_K_M",
    "llama-cpp-qwen/ornith-1.0-9b-Q4_K_M",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-6-astra",
    "z-ai/glm-5.3-flash"
  ],
  "defaultThinkingLevel": "medium",
  "compaction": {
    "enabled": true,
    "reserveTokens": 4096,
    "keepRecentTokens": 12000
  },
  "branchSummary": {
    "reserveTokens": 4096
  },
  "enableInstallTelemetry": false,
  "hideThinkingBlock": false,
  "subagents": {
    "defaultModel": "family-hub/qwen3.8-27b",
    "defaultThinking": "medium",
    "agentOverrides": {
      "scout": {
        "thinking": "low"
      },
      "worker": {
        "thinking": "medium"
      },
      "researcher": {
        "thinking": "medium"
      },
      "reviewer": {
        "thinking": "high"
      },
      "oracle": {
        "thinking": "high"
      }
    },
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "family-hub/qwen3.8-27b",
        "openai-codex/gpt-6.1-sol"
      ]
    }
  },
  "extensionChangelogVersions": {
    "{\"source\":\"npm:@llblab/pi-codex-usage\",\"scope\":\"user\"}": "0.13.4",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.88.0"
  }
}